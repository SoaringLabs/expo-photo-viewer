  "description": "Native fullscreen photo galleries for Expo on iOS",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "prepack": "tsc -p tsconfig.json",
    "example:ios": "pnpm run build && pnpm --filter expo-photo-viewer-example ios"
